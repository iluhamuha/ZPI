# Telegram-бот для получения заявок
# Создайте бота через @BotFather и укажите его токен
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ID чата или канала, куда будут приходить заявки
# Узнать chat_id можно через @userinfobot
TELEGRAM_CHAT_ID=your_chat_id_here

# Порт для запуска сервера (необязательно, по умолчанию 3000)
# PORT=3000
